# Database (SQLite). Local dev uses a file relative to /prisma,
# Docker uses an absolute path inside the volume, e.g. file:/data/app.db
DATABASE_URL="file:./dev.db"

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-secret"

# Initial admin account (created by the seed script on first run)
ADMIN_EMAIL="admin@meerflow.nl"
ADMIN_PASSWORD="Admin123!"
ADMIN_NAME="Beheerder"
